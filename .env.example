# ========================================
# Longevity Clinic — Environment Variables
# ========================================

# Required: Session & Authentication
SESSION_SECRET=generate_a_long_random_string_here
CLINIC_USERNAME=admin
CLINIC_PASSWORD=your_secure_password_here

# Required: Database (Railway will provide this automatically)
DATABASE_URL=postgresql://user:password@host:5432/database

# Required: Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Recommended: Clinical Data Encryption
CLINICAL_ENCRYPTION_KEY=generate_another_long_random_string_here

# Application Settings
NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://yourdomain.com

# Email Configuration (choose one method)
# Option 1: SMTP (e.g., Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Longevity Clinic <noreply@yourdomain.com>

# Option 2: Resend (alternative to SMTP)
RESEND_API_KEY=re_your_resend_api_key

# Optional: Contact & Communication
CONTACT_EMAIL=info@lonclinic.com
CLINIC_WHATSAPP=351928372775

# Optional: Video Consultation
DOXY_ROOM_URL=https://your-doxy-room-url

# Optional: Analytics
ANALYTICS_STAFF_IPS=123.456.789.0,987.654.321.0
